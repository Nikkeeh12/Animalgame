;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="kokeiluu"
run/main_scene="uid://d1k0x17kbk36x"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

SceneLoader="*uid://chiphmyshpomh"
DialogueLoader="*uid://ucde0ruqo6e"

[display]

window/size/viewport_width=640
window/size/viewport_height=320
window/size/transparent=true
window/size/window_width_override=1280
window/size/window_height_override=640
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="kokeiluu"

[file_customization]

folder_colors={
"res://art/": "red",
"res://audio/": "yellow"
}

